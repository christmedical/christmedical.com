# Christ Medical hub — copy to `.env` and edit before first start.
# Never commit real secrets. `.env` is gitignored.

# --- Postgres (container) ---
POSTGRES_DB=christ_medical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# --- API ---
API_PORT=5050
# Prebuilt image override (optional). Default builds from ../api/Dockerfile into
# christmedical-hub-api:local so the hub always matches this repo checkout.
# API_IMAGE=christmedical/christmedical-api:latest
API_IMAGE=christmedical-hub-api:local
ASPNETCORE_ENVIRONMENT=Production

# JWT signing key — use a long random string (32+ chars). Required.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Browser origins allowed to call the API (comma-separated). localhost is always allowed.
CORS_ORIGINS=https://www.christmedical.com,https://christmedical.com,http://localhost:3000

# Seed sample patients (usually false on a real clinic hub).
SEED_DEMO_DATA=false

# --- First admin (idempotent upsert on every API start when both are set) ---
HUB_ADMIN_EMAIL=admin@clinic.local
HUB_ADMIN_PASSWORD=change-me-strong-admin-password
HUB_ADMIN_FIRST_NAME=Admin
HUB_ADMIN_LAST_NAME=User
HUB_TENANT_ID=1
HUB_ADMIN_ROLE=admin

# --- Trip / tenant identity (metadata for operators; optional) ---
HUB_TENANT_SLUG=belize
HUB_TRIP_ID=
