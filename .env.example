# Copy to `.env` (gitignored) for local demo and `make deploy`.
# Use a Docker Hub *access token* as DOCKER_PASSWORD (Account Settings → Security).
# Token must allow **Read & Write** (not read-only) or `docker push` fails with "denied"
# even when `docker login` says Login Succeeded.
# If the token contains `$` or `#`, Make may corrupt it here — use `export DOCKER_PASSWORD=...`
# in your shell before `make deploy` instead.

DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-token-or-password

# Image namespace (prefix before /christmedical-api). Use your username, or an org
# you belong to with push access — can differ from DOCKER_USERNAME on paid/team setups;
# on free Hub your personal namespace is usually your username unless you create an org.
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest

# Early-reviewer feedback tool (default off — never enable in real clinic deploys).
# FEEDBACK_MODE=on
