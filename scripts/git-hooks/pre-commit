#!/bin/bash
#
# Pre-commit hook — optional guard for direct commits to main.
#
# PO/Dev workflow (temporary): CHRISTMEDICAL_ALLOW_MAIN=1 in repo hooks allows main.
# To restore protection: set CHRISTMEDICAL_ALLOW_MAIN=0 and run scripts/install-hooks.sh
#

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# 1 = allow commits on main (current PO workflow). 0 = block (stricter default later).
CHRISTMEDICAL_ALLOW_MAIN="${CHRISTMEDICAL_ALLOW_MAIN:-1}"

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$CHRISTMEDICAL_ALLOW_MAIN" = "1" ]; then
    exit 0
fi

if [ "$BRANCH" = "main" ]; then
    echo -e "${RED}❌ ERROR: Direct commits to 'main' branch are not allowed!${NC}"
    echo ""
    echo -e "${YELLOW}To allow temporarily:${NC} export CHRISTMEDICAL_ALLOW_MAIN=1 or set it in scripts/git-hooks/pre-commit"
    echo ""
    echo -e "${YELLOW}Standard workflow:${NC}"
    echo "  1. Create a feature branch: ${GREEN}git checkout -b feature/your-feature-name${NC}"
    echo "  2. Commit on that branch and open a PR into main"
    echo ""
    exit 1
fi

exit 0
