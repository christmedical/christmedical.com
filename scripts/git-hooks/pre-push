#!/bin/bash
#
# Pre-push hook — optional guard for direct pushes to main.
#
# PO/Dev workflow (temporary): CHRISTMEDICAL_ALLOW_MAIN=1 in repo hooks allows main.
# To restore protection: set CHRISTMEDICAL_ALLOW_MAIN=0 and run scripts/install-hooks.sh
#

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

CHRISTMEDICAL_ALLOW_MAIN="${CHRISTMEDICAL_ALLOW_MAIN:-1}"

if [ "$CHRISTMEDICAL_ALLOW_MAIN" = "1" ]; then
    exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo -e "${RED}❌ ERROR: Direct pushes to 'main' branch are not allowed!${NC}"
        echo ""
        echo -e "${YELLOW}To allow temporarily:${NC} export CHRISTMEDICAL_ALLOW_MAIN=1 or set it in scripts/git-hooks/pre-push"
        echo ""
        echo -e "${YELLOW}Standard workflow:${NC} push a feature branch and open a PR into main"
        echo ""
        exit 1
    fi
done

exit 0
